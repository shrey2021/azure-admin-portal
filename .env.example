# Azure Admin Portal Configuration
# Set DEMO_MODE to "false" to connect to real Azure resources using the credentials below.
# Set DEMO_MODE to "true" to run in offline/simulation mode with sample Azure resources.
DEMO_MODE=true

# Azure Service Principal Credentials
# Leave empty or set your Azure Tenant and App Registration details
AZURE_TENANT_ID=your-azure-tenant-id-here
AZURE_CLIENT_ID=your-azure-client-id-here
AZURE_CLIENT_SECRET=your-azure-client-secret-here
AZURE_SUBSCRIPTION_ID=your-azure-subscription-id-here

# Optional: Default Azure Region for new resources
AZURE_DEFAULT_REGION=eastus

# Application Server Settings
PORT=8000
HOST=127.0.0.1
DEBUG=true
